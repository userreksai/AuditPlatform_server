{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AuditPlatformReadIAM",
    "Effect": "Allow",
    "Action": [
      "iam:GetAccountAuthorizationDetails", "iam:ListAccountAliases",
      "iam:GetPolicy", "iam:GetPolicyVersion", "iam:GetLoginProfile",
      "iam:ListMFADevices", "iam:ListAccessKeys", "iam:GetAccessKeyLastUsed",
      "iam:GenerateCredentialReport", "iam:GetCredentialReport"
    ],
    "Resource": "*"
  }, {
    "Sid": "AuditPlatformReadRDSSecrets",
    "Effect": "Allow",
    "Action": [
      "ec2:DescribeRegions",
      "rds:DescribeDBInstances", "rds:DescribeDBClusters",
      "secretsmanager:DescribeSecret"
    ],
    "Resource": "*"
  }]
}
